    },
    "peerDependencies": {
        "@wharfkit/session": "^1.2.7"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^10.0.1",
        "@types/chai": "^4.3.1",
        "@types/mocha": "^9.0.0",
        "@types/node": "^18.7.18",
        "@types/pako": "^2.0.3",
        "@typescript-eslint/eslint-plugin": "^5.20.0",
        "@typescript-eslint/parser": "^5.20.0",
        "@wharfkit/antelope": "^1.2.0",
        "@wharfkit/mock-data": "^1.3.1",
        "@wharfkit/session": "^1.6.1",
        "@wharfkit/signing-request": "^3.4.0",
        "chai": "^4.3.4",
        "eslint": "^8.13.0",
        "eslint-config-prettier": "^8.1.0",
        "eslint-plugin-prettier": "^4.0.0",
        "mocha": "^10.0.0",
        "nyc": "^15.1.0",
        "pako": "^2.1.0",
        "prettier": "^2.2.1",
        "rollup": "^2.70.2",
        "rollup-plugin-dts": "^4.2.1",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.1.1",
        "typescript": "^4.9.5"
