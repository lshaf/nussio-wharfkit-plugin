    "author": "lshaf",
    "license": "MIT",
    "keywords": [
        "wharfkit",
        "wallet-plugin",
        "antelope",
        "eosio",
        "nussio",
        "browser-extension"
    ],
    "main": "lib/nussio-wharfkit-plugin.js",
    "module": "lib/nussio-wharfkit-plugin.m.js",
    "types": "lib/nussio-wharfkit-plugin.d.ts",
    "exports": {
        ".": {
            "types": "./lib/nussio-wharfkit-plugin.d.ts",
